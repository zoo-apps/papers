{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoo.ngo/schemas/agent-identity-delegation.v1.schema.json",
  "title": "Zoo Decentralized Agent Identity & Delegation Suite (agent-identity-delegation.v1)",
  "description": "Normative JSON Schema Draft 2020-12 for portable W3C DID documents (did:zoo:, did:key:), Zoo Agent NFT / ERC-6551 lineage bindings, W3C Verifiable Credentials v2.0 delegation chains, W3C Bitstring Status List v1.0 offline revocation credentials, signed revocation snapshots, and holder-bound action presentations.",
  "type": "object",
  "required": [
    "schema_version",
    "spec_version",
    "seed",
    "generated_at",
    "stages",
    "threat_cases"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "agent-identity-delegation.v1"
    },
    "spec_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "seed": {
      "type": "integer"
    },
    "generated_at": {
      "type": "integer",
      "minimum": 0
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/StageCase"
      }
    },
    "threat_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ThreatCase"
      }
    }
  },
  "$defs": {
    "PrincipalType": {
      "type": "string",
      "enum": [
        "HUMAN_COUNCIL",
        "ORG_CONTROLLER",
        "AI_AGENT",
        "EPHEMERAL_SESSION"
      ]
    },
    "DataIntegrityProof": {
      "type": "object",
      "required": [
        "type",
        "cryptosuite",
        "verification_method",
        "created",
        "signature_b64"
      ],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "DataIntegrityProof" },
        "cryptosuite": { "const": "eddsa-jcs-2022" },
        "verification_method": { "type": "string", "minLength": 1 },
        "created": { "type": "integer" },
        "signature_b64": { "type": "string", "minLength": 1 }
      }
    },
    "VerificationMethod": {
      "type": "object",
      "required": [
        "id",
        "type",
        "controller",
        "public_key_b64",
        "valid_from",
        "valid_until"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "Ed25519VerificationKey2020" },
        "controller": { "type": "string", "minLength": 1 },
        "public_key_b64": { "type": "string", "minLength": 1 },
        "valid_from": { "type": "integer" },
        "valid_until": { "type": "integer" }
      }
    },
    "KeyRotationProof": {
      "type": "object",
      "required": [
        "did",
        "from_key_id",
        "to_key_id",
        "new_public_key_b64",
        "rotated_at",
        "reason",
        "outgoing_sig_b64",
        "controller_key_id",
        "controller_sig_b64"
      ],
      "additionalProperties": false,
      "properties": {
        "did": { "type": "string", "minLength": 1 },
        "from_key_id": { "type": "string", "minLength": 1 },
        "to_key_id": { "type": "string", "minLength": 1 },
        "new_public_key_b64": { "type": "string", "minLength": 1 },
        "rotated_at": { "type": "integer" },
        "reason": { "type": "string" },
        "outgoing_sig_b64": { "type": "string", "minLength": 1 },
        "controller_key_id": { "type": "string", "minLength": 1 },
        "controller_sig_b64": { "type": "string", "minLength": 1 }
      }
    },
    "AutonomyBounds": {
      "type": "object",
      "required": [
        "max_tx_value_wei",
        "daily_spend_limit_wei",
        "cooldown_seconds",
        "capability_bitmap_hex"
      ],
      "additionalProperties": false,
      "properties": {
        "max_tx_value_wei": { "type": "string" },
        "daily_spend_limit_wei": { "type": "string" },
        "cooldown_seconds": { "type": "integer", "minimum": 0 },
        "capability_bitmap_hex": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$" }
      }
    },
    "AgentNFTBinding": {
      "type": "object",
      "required": [
        "chain_id",
        "nft_contract",
        "token_id",
        "tba_wallet_address",
        "model_hash_sha256",
        "metadata_uri",
        "autonomy_bounds",
        "portable_export_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "chain_id": { "type": "integer", "minimum": 1 },
        "nft_contract": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "token_id": { "type": "string", "minLength": 1 },
        "tba_wallet_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "model_hash_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "metadata_uri": { "type": "string", "minLength": 1 },
        "autonomy_bounds": { "$ref": "#/$defs/AutonomyBounds" },
        "portable_export_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "DIDDocument": {
      "type": "object",
      "required": [
        "@context",
        "id",
        "principal_type",
        "controller",
        "genesis_key_id",
        "genesis_public_key_b64",
        "active_key_id",
        "verification_methods",
        "key_rotations",
        "portable_export",
        "proof"
      ],
      "additionalProperties": false,
      "properties": {
        "@context": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "id": { "type": "string", "pattern": "^did:(zoo:|key:z).+" },
        "principal_type": { "$ref": "#/$defs/PrincipalType" },
        "controller": { "type": "string", "minLength": 1 },
        "genesis_key_id": { "type": "string", "minLength": 1 },
        "genesis_public_key_b64": { "type": "string", "minLength": 1 },
        "active_key_id": { "type": "string", "minLength": 1 },
        "verification_methods": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/VerificationMethod" }
        },
        "key_rotations": {
          "type": "array",
          "items": { "$ref": "#/$defs/KeyRotationProof" }
        },
        "agent_nft_binding": { "$ref": "#/$defs/AgentNFTBinding" },
        "portable_export": { "type": "boolean" },
        "proof": { "$ref": "#/$defs/DataIntegrityProof" }
      }
    },
    "CredentialStatus": {
      "type": "object",
      "required": [
        "id",
        "type",
        "status_purpose",
        "status_list_index",
        "status_list_credential"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "BitstringStatusListEntry" },
        "status_purpose": { "const": "revocation" },
        "status_list_index": { "type": "integer", "minimum": 0 },
        "status_list_credential": { "type": "string", "minLength": 1 }
      }
    },
    "DelegationConstraints": {
      "type": "object",
      "required": [
        "max_calls_per_hour",
        "max_budget_usd_cents",
        "require_holder_proof"
      ],
      "additionalProperties": false,
      "properties": {
        "max_calls_per_hour": { "type": "integer", "minimum": 0 },
        "max_budget_usd_cents": { "type": "integer", "minimum": 0 },
        "require_holder_proof": { "type": "boolean" }
      }
    },
    "DelegationSubject": {
      "type": "object",
      "required": [
        "id",
        "subject_principal_type",
        "delegation_depth",
        "max_sub_depth",
        "parent_vc_id",
        "parent_vc_digest",
        "audience",
        "scopes",
        "allowed_resources",
        "constraints",
        "nonce"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "subject_principal_type": { "$ref": "#/$defs/PrincipalType" },
        "delegation_depth": { "type": "integer", "minimum": 0 },
        "max_sub_depth": { "type": "integer", "minimum": 0 },
        "parent_vc_id": { "type": "string" },
        "parent_vc_digest": { "type": "string" },
        "audience": { "type": "string" },
        "scopes": { "type": "array", "items": { "type": "string" } },
        "allowed_resources": { "type": "array", "items": { "type": "string" } },
        "constraints": { "$ref": "#/$defs/DelegationConstraints" },
        "nonce": { "type": "string", "minLength": 1 }
      }
    },
    "DelegationVC": {
      "type": "object",
      "required": [
        "@context",
        "id",
        "type",
        "issuer",
        "issuer_key_id",
        "valid_from",
        "valid_until",
        "credential_status",
        "credential_subject",
        "proof"
      ],
      "additionalProperties": false,
      "properties": {
        "@context": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "issuer": { "type": "string", "minLength": 1 },
        "issuer_key_id": { "type": "string", "minLength": 1 },
        "valid_from": { "type": "integer" },
        "valid_until": { "type": "integer" },
        "credential_status": { "$ref": "#/$defs/CredentialStatus" },
        "credential_subject": { "$ref": "#/$defs/DelegationSubject" },
        "proof": { "$ref": "#/$defs/DataIntegrityProof" }
      }
    },
    "BitstringStatusListCredential": {
      "type": "object",
      "required": [
        "@context",
        "id",
        "type",
        "issuer",
        "issuer_key_id",
        "valid_from",
        "valid_until",
        "credential_subject",
        "proof"
      ],
      "additionalProperties": false,
      "properties": {
        "@context": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "issuer": { "type": "string", "minLength": 1 },
        "issuer_key_id": { "type": "string", "minLength": 1 },
        "valid_from": { "type": "integer" },
        "valid_until": { "type": "integer" },
        "credential_subject": {
          "type": "object",
          "required": ["id", "type", "status_purpose", "bit_length", "encoding", "encoded_list"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "type": { "const": "BitstringStatusList" },
            "status_purpose": { "const": "revocation" },
            "bit_length": { "type": "integer", "minimum": 8 },
            "encoding": { "enum": ["gzip_base64url", "raw_base64url"] },
            "encoded_list": { "type": "string", "minLength": 1 }
          }
        },
        "proof": { "$ref": "#/$defs/DataIntegrityProof" }
      }
    },
    "KeyRevocationEntry": {
      "type": "object",
      "required": ["did", "key_id", "revoked_before", "revoke_all", "reason"],
      "additionalProperties": false,
      "properties": {
        "did": { "type": "string", "minLength": 1 },
        "key_id": { "type": "string", "minLength": 1 },
        "revoked_before": { "type": "integer", "minimum": 0 },
        "revoke_all": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "RevocationSnapshot": {
      "type": "object",
      "required": [
        "snapshot_id",
        "issuer",
        "issuer_key_id",
        "issued_at",
        "valid_until",
        "status_list_digests",
        "key_revocations",
        "revoked_vc_ids",
        "crl_merkle_root",
        "proof"
      ],
      "additionalProperties": false,
      "properties": {
        "snapshot_id": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string", "minLength": 1 },
        "issuer_key_id": { "type": "string", "minLength": 1 },
        "issued_at": { "type": "integer" },
        "valid_until": { "type": "integer" },
        "status_list_digests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["status_list_id", "digest_sha256"],
            "additionalProperties": false,
            "properties": {
              "status_list_id": { "type": "string", "minLength": 1 },
              "digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "key_revocations": {
          "type": "array",
          "items": { "$ref": "#/$defs/KeyRevocationEntry" }
        },
        "revoked_vc_ids": { "type": "array", "items": { "type": "string" } },
        "crl_merkle_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "proof": { "$ref": "#/$defs/DataIntegrityProof" }
      }
    },
    "HolderProof": {
      "type": "object",
      "required": [
        "holder_did",
        "holder_key_id",
        "delegation_chain_digest",
        "challenge_nonce",
        "audience",
        "action_verb",
        "resource_uri",
        "timestamp",
        "signature_b64"
      ],
      "additionalProperties": false,
      "properties": {
        "holder_did": { "type": "string", "minLength": 1 },
        "holder_key_id": { "type": "string", "minLength": 1 },
        "delegation_chain_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "challenge_nonce": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "action_verb": { "type": "string", "minLength": 1 },
        "resource_uri": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "integer" },
        "signature_b64": { "type": "string", "minLength": 1 }
      }
    },
    "ActionPresentation": {
      "type": "object",
      "required": [
        "presentation_id",
        "eval_time",
        "audience",
        "action_verb",
        "resource_uri",
        "challenge_nonce",
        "delegation_chain"
      ],
      "additionalProperties": false,
      "properties": {
        "presentation_id": { "type": "string", "minLength": 1 },
        "eval_time": { "type": "integer" },
        "audience": { "type": "string" },
        "action_verb": { "type": "string" },
        "resource_uri": { "type": "string" },
        "challenge_nonce": { "type": "string" },
        "delegation_chain": {
          "type": "array",
          "items": { "$ref": "#/$defs/DelegationVC" }
        },
        "holder_proof": { "$ref": "#/$defs/HolderProof" }
      }
    },
    "VerificationContext": {
      "type": "object",
      "required": [
        "trusted_root_dids",
        "expected_audience",
        "used_nonces",
        "did_documents",
        "status_lists",
        "revocation_snapshot",
        "allow_root_direct_actions"
      ],
      "additionalProperties": false,
      "properties": {
        "trusted_root_dids": { "type": "array", "items": { "type": "string" } },
        "expected_audience": { "type": "string" },
        "used_nonces": { "type": "array", "items": { "type": "string" } },
        "did_documents": { "type": "array", "items": { "$ref": "#/$defs/DIDDocument" } },
        "status_lists": { "type": "array", "items": { "$ref": "#/$defs/BitstringStatusListCredential" } },
        "revocation_snapshot": { "$ref": "#/$defs/RevocationSnapshot" },
        "allow_root_direct_actions": { "type": "boolean" }
      }
    },
    "StageCase": {
      "type": "object",
      "required": ["stage_id", "name", "description", "context", "presentation"],
      "additionalProperties": false,
      "properties": {
        "stage_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "context": { "$ref": "#/$defs/VerificationContext" },
        "presentation": { "$ref": "#/$defs/ActionPresentation" }
      }
    },
    "ThreatCase": {
      "type": "object",
      "required": ["case_id", "category", "name", "expect_valid", "expected_error", "context", "presentation"],
      "additionalProperties": false,
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "enum": ["impersonation", "delegation", "revocation", "constitutional"] },
        "name": { "type": "string", "minLength": 1 },
        "expect_valid": { "type": "boolean" },
        "expected_error": { "type": "string" },
        "context": { "$ref": "#/$defs/VerificationContext" },
        "presentation": { "$ref": "#/$defs/ActionPresentation" }
      }
    }
  }
}
