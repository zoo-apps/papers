{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoo.ngo/schemas/thinking-chains/canonical-receipt.v1.schema.json",
  "title": "Thinking Chains Canonical Execution Receipt (v1)",
  "description": "Portable, deterministic, proof-carrying execution receipt for accountable computational work (zoo-apps/papers#7, hip-1352). Covers public evidence and execution traces only; private internal chain-of-thought is strictly prohibited.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "nonce",
    "objective",
    "execution",
    "inputs",
    "authorized_tools",
    "public_evidence",
    "checks",
    "result",
    "provenance",
    "settlement",
    "attestations"
  ],
  "$defs": {
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hex128": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "nonEmptyId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    }
  },
  "properties": {
    "schema_version": {
      "const": "zoo.thinking-chains.receipt.v1"
    },
    "job_id": {
      "$ref": "#/$defs/nonEmptyId"
    },
    "nonce": {
      "$ref": "#/$defs/hex64"
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_type",
        "summary",
        "objective_hash",
        "output_space_id",
        "governance_level",
        "recursion_depth",
        "max_recursion_depth"
      ],
      "properties": {
        "task_type": {
          "type": "string",
          "enum": [
            "math_verification",
            "code_synthesis",
            "corpus_retrieval",
            "benchmark_eval",
            "governance_advisory"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "objective_hash": {
          "$ref": "#/$defs/hex64"
        },
        "output_space_id": {
          "$ref": "#/$defs/nonEmptyId"
        },
        "governance_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "recursion_depth": {
          "type": "integer",
          "minimum": 0
        },
        "max_recursion_depth": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor_id",
        "model_id",
        "model_version",
        "model_spec_hash",
        "execution_profile_id",
        "inference_tier",
        "evidence_mode",
        "public_trace_only",
        "hardware_class"
      ],
      "properties": {
        "executor_id": {
          "$ref": "#/$defs/nonEmptyId"
        },
        "model_id": {
          "$ref": "#/$defs/nonEmptyId"
        },
        "model_version": {
          "$ref": "#/$defs/nonEmptyId"
        },
        "model_spec_hash": {
          "$ref": "#/$defs/hex64"
        },
        "execution_profile_id": {
          "$ref": "#/$defs/nonEmptyId"
        },
        "inference_tier": {
          "type": "string",
          "enum": [
            "tier1_deterministic_int8",
            "tier2_quorum",
            "tier2_attested_tee",
            "tier2_zkml"
          ]
        },
        "evidence_mode": {
          "type": "string",
          "enum": [
            "deterministic_recomputation",
            "quorum_signatures",
            "tee_attestation",
            "zkml_proof"
          ]
        },
        "public_trace_only": {
          "const": true
        },
        "hardware_class": {
          "$ref": "#/$defs/nonEmptyId"
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "role",
          "uri",
          "media_type",
          "byte_length",
          "sha256"
        ],
        "properties": {
          "artifact_id": { "$ref": "#/$defs/nonEmptyId" },
          "role": { "$ref": "#/$defs/nonEmptyId" },
          "uri": { "type": "string", "minLength": 1, "maxLength": 512 },
          "media_type": { "type": "string", "minLength": 1, "maxLength": 128 },
          "byte_length": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/hex64" }
        }
      }
    },
    "authorized_tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seq",
          "tool_name",
          "tool_version",
          "deterministic",
          "args_sha256",
          "output_sha256",
          "wall_time_ms",
          "exit_code"
        ],
        "properties": {
          "seq": { "type": "integer", "minimum": 0 },
          "tool_name": { "$ref": "#/$defs/nonEmptyId" },
          "tool_version": { "$ref": "#/$defs/nonEmptyId" },
          "deterministic": { "type": "boolean" },
          "args_sha256": { "$ref": "#/$defs/hex64" },
          "output_sha256": { "$ref": "#/$defs/hex64" },
          "wall_time_ms": { "type": "integer", "minimum": 0 },
          "exit_code": { "type": "integer" }
        }
      }
    },
    "public_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "kind",
          "uri",
          "byte_length",
          "sha256",
          "public_only"
        ],
        "properties": {
          "evidence_id": { "$ref": "#/$defs/nonEmptyId" },
          "kind": {
            "type": "string",
            "enum": [
              "execution_trace_digest",
              "intermediate_artifact",
              "public_rationale_digest",
              "benchmark_log_digest",
              "prior_receipt_ref",
              "tee_quote_digest"
            ]
          },
          "uri": { "type": "string", "minLength": 1, "maxLength": 512 },
          "byte_length": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/hex64" },
          "public_only": { "const": true }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "check_type",
          "passed",
          "metric_name",
          "metric_bps",
          "threshold_bps",
          "verifier_cmd_sha256",
          "log_sha256"
        ],
        "properties": {
          "check_id": { "$ref": "#/$defs/nonEmptyId" },
          "check_type": {
            "type": "string",
            "enum": [
              "deterministic_replay",
              "unit_test_suite",
              "hash_match",
              "schema_validation",
              "metric_threshold",
              "differential_parity"
            ]
          },
          "passed": { "type": "boolean" },
          "metric_name": { "$ref": "#/$defs/nonEmptyId" },
          "metric_bps": { "$ref": "#/$defs/bps" },
          "threshold_bps": { "$ref": "#/$defs/bps" },
          "verifier_cmd_sha256": { "$ref": "#/$defs/hex64" },
          "log_sha256": { "$ref": "#/$defs/hex64" }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "canonical_output_sha256",
        "output_byte_length",
        "finite_verdict",
        "quality_score_bps",
        "dissent_bps",
        "proposed_action_scope"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["completed", "failed", "contested", "abstained"]
        },
        "canonical_output_sha256": { "$ref": "#/$defs/hex64" },
        "output_byte_length": { "type": "integer", "minimum": 0 },
        "finite_verdict": { "$ref": "#/$defs/nonEmptyId" },
        "quality_score_bps": { "$ref": "#/$defs/bps" },
        "dissent_bps": { "$ref": "#/$defs/bps" },
        "proposed_action_scope": {
          "type": "string",
          "enum": [
            "research_artifact",
            "advisory_recommendation",
            "benchmark_report",
            "model_delta_proposal"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash_algorithm",
        "domain_separator",
        "inputs_root",
        "tools_root",
        "evidence_root",
        "checks_root",
        "result_digest",
        "provenance_root"
      ],
      "properties": {
        "hash_algorithm": { "const": "sha256" },
        "domain_separator": { "const": "zoo.thinking-chains.receipt.v1" },
        "inputs_root": { "$ref": "#/$defs/hex64" },
        "tools_root": { "$ref": "#/$defs/hex64" },
        "evidence_root": { "$ref": "#/$defs/hex64" },
        "checks_root": { "$ref": "#/$defs/hex64" },
        "result_digest": { "$ref": "#/$defs/hex64" },
        "provenance_root": { "$ref": "#/$defs/hex64" }
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id",
        "escrow_ref",
        "intent_id",
        "payer",
        "fee_units",
        "subsidy_eligible",
        "settled_at_height",
        "settled_at_unix",
        "treasury_spend_authorized",
        "voting_rules_modified"
      ],
      "properties": {
        "chain_id": { "$ref": "#/$defs/nonEmptyId" },
        "escrow_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
        "intent_id": { "$ref": "#/$defs/hex64" },
        "payer": { "$ref": "#/$defs/nonEmptyId" },
        "fee_units": { "type": "integer", "minimum": 0 },
        "subsidy_eligible": { "type": "boolean" },
        "settled_at_height": { "type": "integer", "minimum": 0 },
        "settled_at_unix": { "type": "integer", "minimum": 1 },
        "treasury_spend_authorized": { "const": false },
        "voting_rules_modified": { "const": false }
      }
    },
    "attestations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "verifier_id",
          "verifier_role",
          "algorithm",
          "public_key_hex",
          "verdict",
          "attested_receipt_hash",
          "attested_at_unix",
          "signature_hex"
        ],
        "properties": {
          "verifier_id": { "$ref": "#/$defs/nonEmptyId" },
          "verifier_role": {
            "type": "string",
            "enum": [
              "independent_verifier",
              "quorum_validator",
              "hardware_tee_verifier",
              "human_reviewer"
            ]
          },
          "algorithm": { "const": "ed25519" },
          "public_key_hex": { "$ref": "#/$defs/hex64" },
          "verdict": {
            "type": "string",
            "enum": ["VALID", "REJECT", "CONTESTED"]
          },
          "attested_receipt_hash": { "$ref": "#/$defs/hex64" },
          "attested_at_unix": { "type": "integer", "minimum": 1 },
          "signature_hex": { "$ref": "#/$defs/hex128" }
        }
      }
    }
  }
}
